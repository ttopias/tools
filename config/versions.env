# Version and digest pins for docker build --build-arg and runtime image refs.
# Copy/symlink this tree to ~/config.
#
# Output image digests (PR_AGENT_*, PI_SANDBOX_*): set after local build
# (docker inspect --format='{{index .RepoDigests 0}}' IMAGE) and mirror in ~/config/env.

# =============================================================================
# Output images (built from this repo)
# =============================================================================
PR_AGENT_IMAGE=tools-pr-agent:local
PR_AGENT_IMAGE_DIGEST=

PI_SANDBOX_IMAGE=tools-pi-sandbox:local
PI_SANDBOX_IMAGE_DIGEST=

# =============================================================================
# pr-agent image — base layers and upstream
# =============================================================================
PYTHON_BASE_IMAGE=python:3.12.14-slim
PYTHON_BASE_IMAGE_DIGEST=sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

UV_IMAGE=ghcr.io/astral-sh/uv
UV_VERSION=0.12.15
UV_IMAGE_DIGEST=sha256:62f8c047d0a0e9ece6b53fc63df902585a67a47a7f318ddec4a37db586edc8e3

PR_AGENT_REPO=https://github.com/The-PR-Agent/pr-agent.git
PR_AGENT_REF=v0.45.0
PR_AGENT_REF_COMMIT=f3b385ea2927247ddcff2fe252472380b9c8f5fc

# =============================================================================
# pi-sandbox image — base layers and upstream
# =============================================================================
