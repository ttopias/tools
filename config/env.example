# Runtime secrets and flags. Copy to ~/config/env and chmod 600.
#
# Quick setup after clone:
#   ln -sf "$(pwd)/config" ~/config    # or: cp -a config ~/config
#   cp ~/config/env.example ~/config/env && chmod 600 ~/config/env
#
# TLS (runtime): place *.crt in ~/config/certs/
# TLS (bake into image): set CA_CERT in ~/config/versions.env and rebuild

# --- Required: company OpenAI-compatible API ---------------------------------
OPENAI__API_BASE=https://llm.company.example/v1
OPENAI__KEY=

# Pi (optional if OPENAI__KEY is set — pi wrapper copies it)
OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=

# PR-Agent model (gateway-specific)
CONFIG__MODEL=openai/gpt-4o
CONFIG__FALLBACK_MODELS=[]

# --- Airgap ------------------------------------------------------------------
AIRGAP=1
# AIRGAP=0
# AIRGAP_HARDEN=0
# AIRGAP_USER=1000:1000

# --- Container images (keep in sync with ~/config/versions.env) --------------
PR_AGENT_IMAGE=tools-pr-agent:local
PI_SANDBOX_IMAGE=tools-pi-sandbox:local
# Pin by digest after build:
# PR_AGENT_IMAGE=tools-pr-agent@sha256:…
# PI_SANDBOX_IMAGE=tools-pi-sandbox@sha256:…

# DOCKER_RUNTIME=runsc

NODE_USE_SYSTEM_CA=1
NODE_OPTIONS=--use-system-ca

# --- Optional ----------------------------------------------------------------
# TOOLS_CONFIG=/path/to/config-dir
# PR_AGENT_CONFIG=~/config/pr-agent.toml
# PI_AGENTS_DIR=~/.agents   # mounted into pi sandbox (~/.agents/skills, etc.)

# Hosted PR (needs forge egress; not compatible with AIRGAP=1):
# CONFIG__GIT_PROVIDER=github
# GITHUB__USER_TOKEN=
# CONFIG__PUBLISH_OUTPUT=true
