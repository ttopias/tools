#!/usr/bin/env sh
# Run PR-Agent in the air-gapped container against $PWD.
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
AIRGAP_SH="${AIRGAP_SH:-$SCRIPT_DIR/airgap.sh}"
CONFIG_DIR="${TOOLS_CONFIG:-$HOME/config}"
ENV_FILE="${TOOLS_ENV:-$CONFIG_DIR/env}"
CA_DIR="${TOOLS_CA_DIR:-$CONFIG_DIR/certs}"
PR_AGENT_CONFIG="${PR_AGENT_CONFIG:-$CONFIG_DIR/pr-agent.toml}"

usage() {
    cat <<'EOF'
Usage: pr-review <target-branch|pr-url> <command> [args...]

Examples:
  pr-review main review
  pr-review develop describe
  pr-review main ask "Summarize the riskiest changes"
  pr-review https://github.com/org/repo/pull/42 review

Requires ~/config/env (see config/env.example in the tools repo).
EOF
}

require_env() {
    if [ ! -f "$ENV_FILE" ]; then
        echo "pr-review: create $ENV_FILE from config/env.example (see config/README.md)" >&2
        exit 1
    fi
    # shellcheck disable=SC1090
    set -a && . "$ENV_FILE" && set +a
    if [ -z "${OPENAI__API_BASE:-}" ]; then
        echo "pr-review: set OPENAI__API_BASE in $ENV_FILE" >&2
        exit 1
    fi
    if [ -z "${OPENAI__KEY:-}" ]; then
        echo "pr-review: set OPENAI__KEY in $ENV_FILE" >&2
        exit 1
    fi
    if [ -z "${PR_AGENT_IMAGE:-}" ]; then
        echo "pr-review: set PR_AGENT_IMAGE in $ENV_FILE" >&2
        exit 1
    fi
}

append_argv_file() {
    file=$1
    while IFS= read -r -d '' arg; do
        set -- "$@" "$arg"
    done <"$file"
}

if [ "${1:-}" = -h ] || [ "${1:-}" = --help ]; then
    usage
    exit 0
fi

if [ "$#" -lt 2 ]; then
    usage >&2
    exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
    echo "pr-review: docker not found in PATH" >&2
    exit 1
fi

require_env

if [ "${AIRGAP:-1}" = 0 ]; then
    echo "pr-review: WARNING — AIRGAP=0 disables egress lockdown (break-glass only)" >&2
fi

target=$1
shift
command=$1
shift

argv_stash=${TMPDIR:-/tmp}/pr-review.$$.argv
if [ "$#" -gt 0 ]; then
    printf '%s\0' "$@" >"$argv_stash"
else
    : >"$argv_stash"
fi

run_flags=""
if [ -t 0 ] && [ -t 1 ]; then
    run_flags="-it"
fi

# shellcheck disable=SC2086
set -- "$AIRGAP_SH" docker run --rm $run_flags \
    --init \
    --env-file "$ENV_FILE" \
    -v "$PWD:/workspace" \
    -w /workspace
[ -d "$CA_DIR" ] && set -- "$@" -v "$CA_DIR:/certs:ro"
[ -f "$PR_AGENT_CONFIG" ] && set -- "$@" -v "$PR_AGENT_CONFIG:/config/config.toml:ro"
set -- "$@" "$PR_AGENT_IMAGE" --pr_url "$target" "$command"
append_argv_file "$argv_stash"
rm -f "$argv_stash"
exec "$@"
