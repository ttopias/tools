# Copy to ~/.config/pr-review/env and fill in values.
#   mkdir -p ~/.config/pr-review
#   cp /path/to/tools/scripts/env.example ~/.config/pr-review/env
#   chmod 600 ~/.config/pr-review/env
#
# Optional TLS (runtime): mkdir -p ~/.config/pr-review/certs && cp corp-root.crt ~/.config/pr-review/certs/
# Optional TLS (bake into image): docker build --build-arg CA_CERT=corp-root.crt -t tools-pr-agent:local ../pr-agent

# --- Required: company OpenAI-compatible API ---------------------------------
# OpenAI-compatible REST API (used by PR-Agent and airgap egress allowlist)
OPENAI__API_BASE=https://llm.company.example/v1
OPENAI__KEY=

# Model id as your gateway expects (often openai/… prefix).
CONFIG__MODEL=openai/gpt-4o
CONFIG__FALLBACK_MODELS=[]

# --- Airgap (airgap.sh; default on) ------------------------------------------
AIRGAP=1

# --- Optional overrides ------------------------------------------------------
# PR_AGENT_IMAGE=tools-pr-agent:local
# PR_AGENT_DIR=/path/to/tools/pr-agent
# PR_REVIEW_ENV=/path/to/custom/env
# PR_REVIEW_CA_DIR=~/.config/pr-review/certs

# Hosted PR (needs git forge egress; not allowed while AIRGAP=1):
# CONFIG__GIT_PROVIDER=github
# GITHUB__USER_TOKEN=
# CONFIG__PUBLISH_OUTPUT=true
